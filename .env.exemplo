# Copie este arquivo para .env e preencha. O .env contém segredos: não envie por e-mail/chat.

# --- Digisac -----------------------------------------------------------------
# Endereço da conta (o mesmo que aparece no navegador), sem barra no final.
DIGISAC_URL=https://SUACONTA.digisac.app
# Token pessoal: Digisac > Configurações > Tokens (use um usuário administrador).
DIGISAC_TOKEN=
# Alternativa ao token (menos recomendada): login de um usuário administrador.
DIGISAC_EMAIL=
DIGISAC_SENHA=
# Departamentos do Suporte de Ponto (nomes ou IDs, separados por vírgula). Vazio = todos.
DIGISAC_DEPARTAMENTOS=Suporte Ponto
# Na primeira sincronização, quantos dias para trás buscar.
DIGISAC_DIAS_INICIAIS=90
SINCRONIZAR_A_CADA_MINUTOS=2

# --- Inteligência Artificial ------------------------------------------------------
# groq = nuvem, plano gratuito, rápido (segundos); não usa o processador desta máquina.
#        Crie a chave em https://console.groq.com > API Keys e ligue "Zero Data Retention"
#        em Settings > Data Controls (LGPD: o Groq não treina modelos com os dados enviados).
# ollama = modelo aberto rodando nesta máquina (suba com ia-local.cmd); lento sem placa de vídeo
# anthropic = Claude, pago, na nuvem (precisa de ANTHROPIC_API_KEY)
IA_PROVEDOR=groq
GROQ_API_KEY=
# Áudios e vídeos viram texto (Whisper no Groq, gratuito) antes da análise. Só o texto fica salvo.
IA_TRANSCREVER_MIDIA=sim
IA_MODELO_TRANSCRICAO=whisper-large-v3-turbo
OLLAMA_URL=http://127.0.0.1:11434
ANTHROPIC_API_KEY=
IA_HABILITADA=sim
# Groq: openai/gpt-oss-120b (padrão). Ollama: qwen3:14b ou qwen3:8b. Anthropic: claude-opus-5-5
IA_MODELO=openai/gpt-oss-120b
# Só para Claude: low | medium | high (mais alto = mais caro)
IA_ESFORCO=low
IA_ANALISAR_AUTOMATICAMENTE=sim
IA_MAX_POR_CICLO=50
# Núcleos do processador para a IA local (vazio = automático; 10 rende ~15% a mais neste notebook).
IA_THREADS=10

# --- Servidor ----------------------------------------------------------------------
PORTA=4250
# 127.0.0.1 = só esta máquina. Para a coordenação acessar pela rede: 0.0.0.0
HOST=127.0.0.1
SESSAO_HORAS=10
# LGPD: dias que o texto das conversas fica guardado localmente (0 = sem limite).
RETENCAO_MENSAGENS_DIAS=365

# --- GoTo (voz) via Base Bruno -------------------------------------------------
# Pasta com o banco do sistema de gestão das outras áreas (database.db*). O mais recente
# é reimportado sozinho quando muda. Só a fila abaixo é importada.
BASE_GOTO_PASTA=C:/Projetos/Base Bruno
BASE_GOTO_FILA=Ponto Eletrônico
